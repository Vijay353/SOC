# Business Impact Gate — environment configuration (copy to .env; NEVER commit real values)
# All values below are dummies. The default build needs none of them.

# --- Server -------------------------------------------------------------
PORT=4300
HOST=127.0.0.1
DATA_DIR=data/runtime
# ticking = scenario clock advances in real time from 2026-10-18T06:14:00Z (demo default)
# frozen  = clock only moves via the Lab "advance" control (tests, deterministic demos)
CLOCK_MODE=ticking

# --- Integration mode -----------------------------------------------------
# SIMULATED (default) | SANDBOX | LIVE
# SANDBOX/LIVE adapters are TO_VERIFY placeholders: they fail closed and never return simulated data.
INTEGRATION_MODE=SIMULATED
# LIVE additionally requires an explicit opt-in. Never set this on a shared or demo machine.
ENABLE_LIVE_INTEGRATIONS=false

# --- Upstream HTTP behaviour ------------------------------------------------
UPSTREAM_TIMEOUT_MS=1500
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_RETRY_BASE_MS=150

# --- Simulator service tokens (optional) -----------------------------------
# Generated randomly per process when unset. Server-side only; never sent to the browser.
SIM_GATE_SECURITY_TOKEN=
SIM_GATE_ITSM_TOKEN=
SIM_ADMIN_TOKEN=

# --- Optional model-backed constraint extractor (disabled by default) ------
# deterministic (default) | anthropic
EXTRACTOR_PROVIDER=deterministic
ANTHROPIC_API_KEY=sk-ant-dummy-value-do-not-use
EXTRACTOR_MODEL_ID=

# --- SANDBOX placeholders: Microsoft Graph / Defender (app registration) ---
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=dummy-client-secret

# --- SANDBOX placeholders: ServiceNow developer instance -------------------
SERVICENOW_INSTANCE=dev00000.service-now.com
SERVICENOW_USER=dummy.integration.user
SERVICENOW_PASSWORD=dummy-password

# --- Production (CH-22). Set in the deployment panel, not in a committed file ---
# NODE_ENV=production turns on start-up checks: DATA_DIR must be an absolute, writable, persistent directory,
# the databases are never seeded or reset on start, and the scenario clock continues across restarts.
# NODE_ENV=production
# HOST=0.0.0.0
# DATA_DIR=/data
# Backups (scripts/backup.ts): a directory outside DATA_DIR, how many to keep, and whether old ones may be removed.
# BACKUP_DIR=/backups
# BACKUP_KEEP=7
# BACKUP_PRUNE=no

# --- Visitor passcode gate (CH-20). Always on in production; set the real values only as panel secrets ---
# ACCESS_GATE=on turns it on locally for trying it. Never a VITE_ variable.
# ACCESS_GATE=off
# ACCESS_PIN=0000
# ACCESS_SESSION_SECRET=replace-with-at-least-32-random-characters
# ACCESS_SESSION_MINUTES=120
# TRUST_PROXY=1

# --- Analytics after entry (CH-21). Optional; a public identifier from your existing Clarity project ---
# Off when unset. Outside production it also needs ANALYTICS_ENABLED=true.
# CLARITY_PROJECT_ID=
# ANALYTICS_ENABLED=false
