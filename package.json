{
  "name": "containment-assurance",
  "version": "0.1.0",
  "description": "Business Impact Gate \u2014 conceptual, synthetic extension for Microsoft Defender XDR manual containment (not a Microsoft product)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/src/index.ts\" \"vite\"",
    "start": "tsx server/src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "generate:workbooks": "tsx scripts/generate-workbooks.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vite build",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run secret-scan && npm run test:e2e",
    "build:server": "esbuild server/src/index.ts scripts/bootstrap.ts scripts/backup.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outbase=. --outdir=dist-server --out-extension:.js=.mjs --log-level=warning",
    "start:prod": "node dist-server/server/src/index.mjs",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
